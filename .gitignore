# macOS 시스템 파일
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Node.js 의존성
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python 캐시 및 가상환경
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/

# 내장형 포터블 파이썬 바이너리 (수 GB 대용량으로 Git 저장소 제외)
# 필요 시 scripts/setup-binaries.js 또는 릴리즈 에셋을 통해 배포
bin/

# 사용자 데이터 및 로컬 DB (개인 음성 및 생성 결과 보호)
data/

# Electron 빌드 산출물
dist/

# 로그 및 임시 파일
*.log
logs/
temp/
tmp/

# 로컬 환경 변수
.env
.env.local
